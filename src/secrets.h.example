// Template for local WiFi/XToys credentials.
// Copy this file to "secrets.h" (same folder) and fill in your own values.
// secrets.h itself is gitignored and must never be committed.
#pragma once

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Pick exactly ONE of the three XToys connection modes below by setting it to 1
// (leave the other two at 0).
//
// Shared webhook:    set XTOYS_USE_SHARED to 1 and provide XTOYS_WEBHOOK_ID + XTOYS_AUTH_TOKEN
//                    from your XToys profile's Shared Webhooks section.
// Private webhook:   set XTOYS_USE_PRIVATE to 1 and provide XTOYS_WEBHOOK_ID
//                    from your XToys profile's Private Webhook section (no token needed).
// Custom Toy:        set XTOYS_USE_CUSTOMTOY to 1 and provide XTOYS_WEBSOCKET_ID,
//                    XTOYS_AUTH_TOKEN, and XTOYS_TOY_IDENTIFIER from the "New/Edit Custom Toy"
//                    dialog's Websocket Info section in XToys. This is the recommended mode.
#define XTOYS_USE_SHARED 0
#define XTOYS_USE_PRIVATE 0
#define XTOYS_USE_CUSTOMTOY 1

#if XTOYS_USE_SHARED
  #define XTOYS_WEBHOOK_ID "your-shared-webhook-id"
  #define XTOYS_AUTH_TOKEN "your-shared-webhook-auth-token"
#endif

#if XTOYS_USE_PRIVATE
  #define XTOYS_WEBHOOK_ID "your-private-webhook-id"
#endif

#if XTOYS_USE_CUSTOMTOY
    // XToys Custom Toy (Generic Input/Output) connection info, from the
    // "New Custom Toy" dialog's Websocket Info section.
    #define XTOYS_WEBSOCKET_ID "your-custom-toy-websocket-id"
    #define XTOYS_AUTH_TOKEN   "your-custom-toy-token"
    // Must match the Custom Toy's "Identifier" field.
    #define XTOYS_TOY_IDENTIFIER "EJECT"
#endif
